{
  "name": "molecule-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint",
    "solver:dev": "services/solver/.venv/bin/uvicorn app.main:app --app-dir services/solver --reload --port 8000",
    "solver:lint": "services/solver/.venv/bin/ruff check services/solver && services/solver/.venv/bin/mypy services/solver/app",
    "solver:test": "services/solver/.venv/bin/pytest services/solver/tests -q",
    "test": "turbo run test --concurrency=2",
    "test:adversary": "pnpm --filter @molecule/orchestrator test && pnpm solver:test",
    "typecheck": "turbo run typecheck",
    "verify:openai": "node --import tsx scripts/verify-openai.ts",
    "verify:desktop": "node --import tsx scripts/verify-desktop.mjs",
    "verify:voice": "node --import tsx scripts/verify-voice.mjs",
    "verify:kit": "node --import tsx scripts/verify-kit.mjs",
    "verify:golden": "node --import tsx scripts/verify-golden.mjs",
    "verify:durable": "pnpm --filter @molecule/orchestrator exec vitest run src/durableRuntime.integration.test.ts",
    "verify:secrets": "node scripts/verify-no-client-secrets.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/src/scripts/migrate.ts --seed-only",
    "db:reset": "node --env-file-if-exists=.env --import tsx packages/db/src/scripts/reset.ts",
    "shopify:fake:sync": "SHOPIFY_MODE=fake node --env-file-if-exists=.env scripts/shopify-sync.mjs",
    "shopify:fake:writeback": "SHOPIFY_MODE=fake node --env-file-if-exists=.env scripts/shopify-writeback.mjs",
    "shopify:fake:capacity": "SHOPIFY_MODE=fake node --env-file-if-exists=.env scripts/shopify-set-capacity.mjs",
    "shopify:fake:reset": "node scripts/shopify-fake-reset.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "4.8.0",
    "@types/node": "26.6.2",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  }
}
