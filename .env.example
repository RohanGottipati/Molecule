# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_COMPILER_MODEL=gpt-5.6-terra
USE_MOCK_OPENAI=true

# Backboard
BACKBOARD_API_KEY=
BACKBOARD_MODE=demo
BACKBOARD_DEFAULT_PROVIDER=
BACKBOARD_FAST_MODEL=
BACKBOARD_REASONING_MODEL=
BACKBOARD_VISION_MODEL=
# Isolated local journal for scripts/verify-backboard.ts --execute
# (must be postgresql://127.0.0.1/.../molecule_backboard_smoke_*).
BACKBOARD_SMOKE_DATABASE_URL=

# Tiger Data / PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/molecule
# local is a file-backed demonstration; postgres enables durable provider adapters.
STORAGE_MODE=local

# Shopify central app
SHOPIFY_CLIENT_ID=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_MODE=demo
SHOPIFY_STOREFRONT_DOMAIN=
# Optional static token. Otherwise exchange SHOPIFY_CLIENT_ID + SHOPIFY_API_SECRET
# for renewable tokens (app and stores must share a Shopify organization).
SHOPIFY_ACCESS_TOKEN=
# Optional JSON keyed by merchantId, e.g. {"thread-forge":{"domain":"threadforge-test.myshopify.com"}}.
# auth:{accessToken} or auth:{clientId,clientSecret} may override shared credentials.
# With shared credentials and no JSON, known SHOPIFY_STORES handles are mapped.
SHOPIFY_SUPPLIER_STORES=
# Comma-separated dev store subdomains (before .myshopify.com)
SHOPIFY_STORES=
# Legacy storefront alias; conflicting values are rejected.
MOLECULE_STOREFRONT_DOMAIN=
# Isolated local journal for scripts/verify-shopify-execution.mjs --execute
# (must be postgresql://127.0.0.1/.../molecule_shopify_smoke_*).
SHOPIFY_SMOKE_DATABASE_URL=
SHOPIFY_SMOKE_SOLVER_URL=

# Services
ORCHESTRATOR_URL=http://localhost:3001
PORT=3001
HOST=127.0.0.1
DATA_DIR=.molecule-data
SOLVER_URL=http://localhost:8000
REALITY_URL=http://localhost:3002
MERCHANT_AGENTS_URL=http://localhost:3003
ALLOWED_ORIGIN=http://localhost:3000
DESKTOP_ORIGIN=http://127.0.0.1:5173
WEB_APP_URL=http://localhost:3000

# Demo
DEMO_MODE=true
CHAOS_SECRET=replace-with-at-least-16-characters
REAL_EXECUTION_ENABLED=false
DEMO_DEFAULT_CURRENCY=CAD
