# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_COMPILER_MODEL=gpt-5.6-terra
USE_MOCK_OPENAI=true

# Backboard
BACKBOARD_API_KEY=
BACKBOARD_MODE=demo
BACKBOARD_DEFAULT_PROVIDER=
BACKBOARD_FAST_MODEL=
BACKBOARD_REASONING_MODEL=
BACKBOARD_VISION_MODEL=

# Tiger Data / PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/molecule
# local is a file-backed demonstration; postgres enables durable provider adapters.
STORAGE_MODE=local

# Shopify central app
SHOPIFY_CLIENT_ID=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_MODE=demo
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
# JSON keyed by merchantId: {"domain":"supplier.myshopify.com","auth":{"accessToken":"..."}}.
SHOPIFY_SUPPLIER_STORES=
# Comma-separated dev store subdomains (before .myshopify.com)
SHOPIFY_STORES=
MOLECULE_STOREFRONT_DOMAIN=

# Services
ORCHESTRATOR_URL=http://localhost:3001
PORT=3001
HOST=127.0.0.1
DATA_DIR=.molecule-data
SOLVER_URL=http://localhost:8000
REALITY_URL=http://localhost:3002
MERCHANT_AGENTS_URL=http://localhost:3003
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:3001
ALLOWED_ORIGIN=http://localhost:3000
DESKTOP_ORIGIN=http://127.0.0.1:5173
WEB_APP_URL=http://localhost:3000

# Demo
DEMO_MODE=true
CHAOS_SECRET=replace-with-at-least-16-characters
NEXT_PUBLIC_DEMO_MODE=true
REAL_EXECUTION_ENABLED=false
DEMO_DEFAULT_CURRENCY=CAD
